# ==============================================================================
# Monorepo Root .gitignore - Legal AI Assistant
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519
secrets/

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# ------------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript (apps/web, packages/ui)
# ------------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.npm/
.yarn/
.pnpm-store/

# Next.js build output
.next/
out/

# Build and bundle outputs
dist/
build/
*.tsbuildinfo
next-env.d.ts.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Python (apps/api)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c

# Distribution / packaging
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
.installed.cfg
*.egg-info/
*.egg

# PyInstaller / Py2app
*.manifest
*.spec

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Python tools caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# Testing & Code Quality Outputs
# ------------------------------------------------------------------------------
coverage/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# Infrastructure & Local Storage (infra/)
# ------------------------------------------------------------------------------
.data/
postgres_data/
redis_data/
docker-compose.override.yml

# ------------------------------------------------------------------------------
# Temporary Files & Scratch Space
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*~
tmp/
scratch/
