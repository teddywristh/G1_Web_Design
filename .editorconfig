# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4
max_line_length = 88

# JavaScript, TypeScript, Web files
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

# Styles
[*.{css,scss,sass,less}]
indent_size = 2

# Configuration & Data files
[*.{json,json5,yaml,yml,toml}]
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# PowerShell scripts
[*.{ps1,psm1}]
indent_size = 4

# Markdown files
[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

# Dockerfile
[Dockerfile*]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
