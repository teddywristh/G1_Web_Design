# ==============================================================================
# Next.js Frontend Configuration (apps/web/.env.example)
# Copy to apps/web/.env.local for local development.
# ==============================================================================

# Backend API base URL accessible by browser and Next.js SSR
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Environment (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# Application Display Name
NEXT_PUBLIC_APP_NAME="Legal AI Assistant"

# Optional client-side analytics or telemetry
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Public Firebase project Web API key (not an AI provider secret).
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local development only; leave empty on hosted/production websites.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Google Cloud OAuth Web client ID (public, same value as backend).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
