APP_ENV=development
APP_NAME=legal-api
FIREBASE_PROJECT_ID=demo-legal-api
FIREBASE_STORAGE_BUCKET=demo-legal-api.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
STORAGE_EMULATOR_HOST=http://127.0.0.1:9198
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8085","http://127.0.0.1:8085"]
MAX_UPLOAD_SIZE_BYTES=20971520
STORAGE_TIMEOUT_SECONDS=30
UPLOAD_LEASE_SECONDS=900
ORPHAN_GRACE_SECONDS=3600

# Optional RAG feature from AI_RAG; other backend endpoints do not require this key.
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# Embeddings are independent of the answering model; OpenRouter uses a dedicated system key.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_URL=http://127.0.0.1:8010
LOCAL_EMBEDDING_MODEL=nvidia/Nemotron-3.5-Embed-1B-BF16
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_TIMEOUT_SECONDS=120
LOCAL_EMBEDDING_PROFILE_VERSION=bf16-sdpa-512-l2-v1
BRAVE_SEARCH_API_KEY=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_EMBEDDING_API_KEY=
RAG_TOP_K=5
RAG_MIN_RETRIEVAL_SCORE=0.15

# AI connections: symmetric encryption key for credentials stored in Firestore.
# Generate once; keep in a secrets manager, stable across all backend instances.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_ALLOW_SHARED_KEYS=true
AI_REQUEST_TIMEOUT_SECONDS=30
OPENCODE_LOCAL_ENABLED=false
OPENCODE_CHATGPT_LOCAL_ENABLED=false
# Hosted: run the isolated OpenCode workers for remote clients (requires Docker on the API host).
OPENCODE_CHATGPT_HOSTED_ENABLED=false
OPENCODE_API_KEYS_HOSTED_ENABLED=false
# Path to OpenCode 1.17.11 and a trusted Python worker image.
OPENCODE_BINARY=
# Optional public OpenCode catalog cache, needed for models newer than the binary's bundled list.
OPENCODE_MODELS_FILE=~/.cache/opencode/models.json
OPENCODE_IMAGE=legal-api-backend:verify
AI_MAX_OUTPUT_TOKENS=2048
# Optional shared Claude API key/model. API keys are separate from Claude Pro login.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_VERSION=2023-06-01

# Sessions: set secure=true in production; SameSite=none requires HTTPS.
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Public Google OAuth web client ID; must match the frontend value.
GOOGLE_OAUTH_CLIENT_ID=
# Public Firebase Web API key, only needed for existing Firebase password accounts.
FIREBASE_WEB_API_KEY=

# Email OTP, TLS on port 587. Gmail requires an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Knowledge bases, ingestion worker and legal Q&A (see docs/knowledge-rag.md).
KNOWLEDGE_UPLOAD_ENABLED=true
QA_WORKFLOW_ENABLED=true
OFFICIAL_WEB_ENABLED=true
EXAMPLE_SEARCH_ENABLED=false
EMBEDDING_DIMENSIONS=1536
# 0 processes all chunks; a positive value limits embedding coverage.
EMBEDDING_MAX_CHUNKS=0
EMBEDDING_BATCH_SIZE=1
OCR_ENABLED=true
OCR_SERVICE_URL=http://127.0.0.1:8011
OCR_FALLBACK_BINARY=tesseract
OCR_TIMEOUT_SECONDS=180
