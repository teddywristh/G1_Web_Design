# ==============================================================================
# FastAPI Backend Configuration (apps/api/.env.example)
# Copy to apps/api/.env for local development.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Legal AI Assistant API"
API_V1_PREFIX=/api/v1
SECRET_KEY=generate_a_secure_random_key_for_jwt_and_sessions

# CORS Settings (JSON list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://legal_ai:change_me@localhost:5432/legal_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# AI & LLM Provider API Keys (Placeholders)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
