{
  "hosting": {
    "public": "dist/hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]},
      {"source": "**/*.@(html|js|css)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {
    "rules": "infra/firebase/firestore.rules",
    "indexes": "infra/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "infra/firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8081
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9198
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
