# ==============================================================================
# Root Environment Configuration Template - Legal AI Assistant Monorepo
# Copy this file to .env or use app-specific .env.example files as needed.
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Next.js Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Legal AI Assistant

# FastAPI Backend (apps/api)
PROJECT_NAME=Legal AI Assistant API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Firebase (backend uses Firebase Admin SDK)
APP_ENV=development
APP_NAME=legal-ai
FIREBASE_PROJECT_ID=legal-ai-dev
FIREBASE_STORAGE_BUCKET=legal-ai-dev.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
STORAGE_EMULATOR_HOST=127.0.0.1:9199

# External LLM / AI Services (Placeholders)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
